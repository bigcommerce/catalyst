{
  "name": "@bigcommerce/catalyst-client",
  "description": "BigCommerce API client for Catalyst.",
  "version": "1.0.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigcommerce/catalyst",
    "directory": "packages/client"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node ../../core/scripts/typecheck.mjs",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "test": "vitest run",
    "gen-types": "dotenv -e .env.local -- node scripts/types.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@0no-co/graphql.web": "^1.1.2",
    "std-env": "^3.9.0"
  },
  "devDependencies": {
    "@bigcommerce/eslint-config-catalyst": "workspace:^",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^8.0.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
